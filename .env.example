# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 절대 커밋하지 않는다.

PORT=8787
HOST=127.0.0.1

# --- 리드 저장 ---------------------------------------------------------
# 로컬 원장은 항상 기록된다. 아래는 구글 시트로도 밀어 넣고 싶을 때만.
# docs/google-sheets-webhook.gs 를 Apps Script 에 붙여 넣고 웹앱으로 배포한 URL.
SHEETS_WEBHOOK_URL=

# --- 알림 --------------------------------------------------------------
# NOTIFY_KIND: slack | discord | telegram | generic | none
NOTIFY_KIND=none
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 운영 --------------------------------------------------------------
# /admin?token=... 리드 확인 화면. 길고 무작위한 값으로.
ADMIN_TOKEN=

# 정적 호스팅(예: GitHub Pages)에서 이 API 를 호출할 경우 그 오리진을 적는다.
ALLOWED_ORIGINS=

RATE_WINDOW_MS=600000
RATE_MAX=5
