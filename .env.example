# 로컬에서 돌릴 때는 이 파일을 .env 로 복사해서 값을 채운다. .env 는 절대 커밋하지 않는다.
# Vercel 배포에서는 이 값들을 Project Settings → Environment Variables 에 넣는다.

PORT=8787
HOST=127.0.0.1

# --- 알림 겸 리드 기록: 텔레그램 -----------------------------------------
#
# 방향이 반대인 경로가 두 개 있다.
#
#   알림 (TELEGRAM_BOT_TOKEN)             : 서버 → 사장님.  신청 폼에 남은 리드.
#   문의 (TELEGRAM_INQUIRY_BOT_TOKEN)     : 고객 → 사장님.  페이지의 "텔레그램 문의" 버튼.
#
# **봇 하나로도 된다.** 단, TELEGRAM_CHAT_ID 가 반드시 박혀 있어야 한다.
# 문의 봇 토큰이 비어 있으면 알림 봇을 그대로 문의용으로도 쓴다(server/config.mjs).
#
# 나눠야 하는 상황은 하나다 — chat_id 를 고정하지 않은 채로 봇 주소를 공개하는 것.
# 그러면 고객이 그 봇 대화 목록에 들어오고 목적지 자동 탐색이 그 고객을 고를 수 있다.
# 신청자의 이름과 전체 전화번호가 낯선 사람에게 간다. 그 조합은 아예 켜지지 않게
# 막아 두었다(문의 중계가 안 돌고, doctor 가 실패로 잡는다).
#
# 정리하면: chat_id 를 고정하라. 그러면 봇을 몇 개 쓰든 안전하다.

# 사장님 확정 채널(2026-09-02). @BotFather 에서 봇을 만들면 나오는 토큰.
TELEGRAM_BOT_TOKEN=

# 알림이 도착할 사장님 chat_id. **고정하는 것을 강력히 권장한다.**
# 비워 두면 알림 봇의 최근 대화에서 찾아내는데, 그 봇에 대화가 둘 이상이면 접수가 멈춘다.
# 값을 모르면: 알림 봇에게 아무 말이나 보낸 뒤 `npm run telegram -- status` 대신
# https://api.telegram.org/bot<토큰>/getUpdates 를 열어 message.chat.id 를 확인한다.
TELEGRAM_CHAT_ID=

# --- 고객 문의 봇 (IB-10) — 선택 -----------------------------------------
# /broker, /signup 의 "텔레그램 문의" 버튼이 향하는 봇.
#
# **비워 둬도 된다.** 비어 있고 TELEGRAM_CHAT_ID 가 박혀 있으면 위 알림 봇이
# 문의도 같이 받는다. 그때는 사장님 대화 하나에 리드 알림과 고객 문의가 섞여 들어온다.
# 문의를 별도 봇으로 분리하고 싶을 때만 여기에 그 봇 토큰을 넣는다.
#
# 페이지 버튼 주소는 손으로 맞추지 않는다 — public/config.js 의 telegramUrl 을
# 비워 두면 /api/health 가 알려주는 "실제로 읽고 있는 봇" 을 따라간다.
TELEGRAM_INQUIRY_BOT_TOKEN=

# setWebhook 의 secret_token. 이 값이 없으면 /api/telegram 은 503 으로 닫혀 있다.
# 공개된 주소라서 확인 없이 열면 누구나 가짜 문의를 만들어 넣을 수 있다.
#   생성: openssl rand -hex 24
#   등록: npm run telegram -- set https://<도메인>/api/telegram
#   확인: npm run telegram -- status
TELEGRAM_WEBHOOK_SECRET=

# --- 리드 저장: 구글 시트 (선택) -----------------------------------------
# docs/google-sheets-webhook.gs 를 Apps Script 에 붙여 넣고 웹앱으로 배포한 URL.
#
# 서버리스(Vercel)에는 로컬 JSONL 원장이 없다. 리드를 다시 읽을 수 있는 곳은
# 텔레그램과 이 시트뿐이고, 둘 다 실패하면 접수 자체를 거절한다(api/lead.js).
# 텔레그램만으로도 돌아가지만, 건수가 쌓이면 시트를 붙이는 쪽이 훨씬 편하다.
SHEETS_WEBHOOK_URL=

# --- 알림 전용 채널 (선택) -----------------------------------------------
# 공유 채널일 수 있어서 연락처 뒤 4자리만 보낸다. 리드 기록으로는 치지 않는다.
# NOTIFY_KIND: slack | discord | generic | none
NOTIFY_KIND=none
NOTIFY_WEBHOOK_URL=

# --- 운영 ----------------------------------------------------------------
# /admin?token=... 리드 확인 화면 (로컬 서버 전용. 서버리스에는 원장이 없어 뜨지 않는다).
# 길고 무작위한 값으로.
ADMIN_TOKEN=

# 다른 도메인의 페이지가 이 API 를 호출할 경우 그 오리진을 적는다 (쉼표 구분).
# Vercel 에서 페이지와 API 를 같이 서빙하면 동일 출처라 비워 두면 된다.
ALLOWED_ORIGINS=

RATE_WINDOW_MS=600000
RATE_MAX=5

# --- 테스트 전용 ----------------------------------------------------------
# 가짜 텔레그램 서버로 갈아끼울 때만 쓴다 (scripts/smoke-serverless.mjs).
# TELEGRAM_API_BASE=http://127.0.0.1:8899
